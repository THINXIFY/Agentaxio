{
  "name": "agentaxio",
  "private": true,
  "version": "0.0.0",
  "description": "AgentAxio monorepo root. Frontend foundation milestone; backend (apps/api, packages/*) is intentionally not started.",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @agentaxio/web dev",
    "build": "pnpm --filter @agentaxio/web build",
    "start": "pnpm --filter @agentaxio/web start",
    "lint": "pnpm --filter @agentaxio/web lint",
    "typecheck": "pnpm --filter @agentaxio/web typecheck",
    "test": "pnpm --filter @agentaxio/web test",
    "format": "pnpm --filter @agentaxio/web format",
    "format:check": "pnpm --filter @agentaxio/web format:check",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  }
}
