{
  "name": "agentaxio",
  "private": true,
  "version": "0.0.0",
  "description": "AgentAxio monorepo root. apps/web is the approved frontend (mock data); apps/api and packages/* are the M01 backend scaffold (local only, no deployment).",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @agentaxio/web dev",
    "build": "pnpm --filter @agentaxio/web build",
    "start": "pnpm --filter @agentaxio/web start",
    "lint": "pnpm -r --workspace-concurrency=1 --if-present lint",
    "typecheck": "pnpm -r --workspace-concurrency=1 --if-present typecheck",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "format": "pnpm -r --workspace-concurrency=1 --if-present format",
    "format:check": "pnpm -r --workspace-concurrency=1 --if-present format:check",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  }
}
