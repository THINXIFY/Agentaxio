# AgentAxio web — environment template. Copy to .env.local (git-ignored).
# The frontend foundation needs no secrets. Do NOT put credentials, API keys or
# billing/auth secrets here; real values never belong in this file or in source control.

# Public, non-secret site origin used for metadata/canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Live mode (optional). Leave unset to keep the labelled demo dashboard on invented data. When set, the dashboard reads
# real data from the AgentAxio management API (apps/api: pnpm --filter @agentaxio/api dev:management) and the browser
# reaches it through this site /api/auth/* and /api/v1/* paths. Must be https unless it is on this machine.
# The API setting AXO_WEB_ORIGIN must equal this site origin, and AXO_OIDC_REDIRECT_URI must be <origin>/api/auth/callback.
# AXO_API_URL=http://127.0.0.1:8788

# Where n8n should send requests (shown on the Integrations page only; not a secret). Defaults to the local agent API.
# AXO_AGENT_API_URL=http://127.0.0.1:8787
