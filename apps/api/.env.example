# Local development only. Copy to apps/api/.env (git-ignored). Never commit real values.
# Runtime database roles are created by migrations (slice B2); until then these are placeholders.
DATABASE_URL=postgres://axo_agent_api:change-me@127.0.0.1:5432/agentaxio_dev

# Server-side secret mixed into agent-key hashes. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# The process must refuse to start when this is missing.
AXO_CREDENTIAL_PEPPER=
