# Local development only. `pnpm --filter @agentaxio/api db:setup` generates apps/api/.env for you with random passwords
# and a random pepper; this file only documents the variables. Never commit apps/api/.env or any real value.

# The schema owner. Used only by db:migrate and db:seed, never by a running service.
AXO_MIGRATOR_DATABASE_URL=postgres://axo_migrator:change-me@127.0.0.1:5432/agentaxio_dev
# The three runtime roles. Each service gets only its own.
AXO_AGENT_API_DATABASE_URL=postgres://axo_agent_api:change-me@127.0.0.1:5432/agentaxio_dev
AXO_MANAGEMENT_DATABASE_URL=postgres://axo_management:change-me@127.0.0.1:5432/agentaxio_dev
# The trusted executor's role has no table privileges at all; it can only call five database functions.
AXO_EXECUTOR_DATABASE_URL=postgres://axo_executor:change-me@127.0.0.1:5432/agentaxio_dev

# Server-side secret mixed into agent-key digests: at least 32 random bytes, base64url. The service refuses to start
# without it. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AXO_CREDENTIAL_PEPPER=

# Encryption keys for stored action parameters and login secrets (AES-256-GCM). A JSON object of key id -> 32 random
# bytes (base64url); AXO_DATA_KEY_ID names the key used for NEW data, older ids stay readable. Local development only:
# a real deployment takes these from a key-management service (docs/BE-02-DECISIONS.md D9).
AXO_DATA_KEYS=
AXO_DATA_KEY_ID=k1

# --- Management (human) API: OpenID Connect sign-in. AgentAxio never sees a password. -----------------------------
# Any standards-compliant provider works. The issuer must be https unless AXO_OIDC_ALLOW_INSECURE=true (local only).
AXO_OIDC_ISSUER=
AXO_OIDC_CLIENT_ID=
AXO_OIDC_CLIENT_SECRET=
# Must match what is registered at the provider; it is served by the web app, which proxies /api/auth/* to this API.
AXO_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
# The one browser origin allowed to make state-changing requests.
AXO_WEB_ORIGIN=http://localhost:3000
# Development switches. Each is refused when NODE_ENV=production.
# AXO_OIDC_ALLOW_INSECURE=true
# AXO_COOKIE_SECURE=false
# AXO_MFA_REQUIRED=false

# --- Trusted executor and the mock CRM it calls (a MOCK; never point this at real data) ------------------------------
AXO_MOCK_CRM_URL=http://127.0.0.1:8790
# Held by the executor and the mock CRM only. At least 32 characters.
AXO_MOCK_CRM_TOKEN=
# AXO_EXECUTOR_ID=executor-1
# AXO_EXECUTOR_TIMEOUT_MS=10000

# Optional. The API listens on loopback unless you change HOST on purpose.
HOST=127.0.0.1
# The agent API listens on 8787, the management API on 8788 (set PORT per process), the mock CRM on 8790.
PORT=8787
LOG_LEVEL=info
